{
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "category": "SocialNetworking",
    "shortDescription": "Thread-focused Matrix client",
    "longDescription": "A private thread-focused build of Cinny.",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": false
  },
  "build": {
    "beforeBuildCommand": "npm --prefix .. run build:desktop",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm --prefix .. start -- --port 8080",
    "devUrl": "http://localhost:8080"
  },
  "productName": "Cinny Threads",
  "mainBinaryName": "cinny-threads",
  "version": "4.12.6-threads.1",
  "identifier": "io.github.purpleempress.CinnyThreads",
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; media-src 'self' blob: http: https:; font-src 'self' data:; connect-src 'self' ipc: ws: wss: http: https:; worker-src 'self' blob:; frame-src http: https:"
    }
  }
}
